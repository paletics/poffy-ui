  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "catalog:",
    "@poffy-ui/behavior": "workspace:*",
    "@poffy-ui/system": "workspace:*",
    "@poffy-ui/types": "workspace:*",
    "@radix-ui/react-slot": "catalog:",
    "motion": "catalog:",
    "prismjs": "catalog:",
    "tslib": "catalog:"
  },
  "scripts": {
    "build": "panda codegen && panda cssgen && tsup && node scripts/add-use-client-directives.mjs && node scripts/check-use-client-directives.mjs && tsc --project tsconfig.json --emitDeclarationOnly --outDir dist/types && node ../../scripts/copy-dts-to-dmts.mjs dist/types && node ../../scripts/prune-react-internal-declarations.mjs",
    "check:client-boundaries": "node scripts/check-use-client-directives.mjs",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "panda codegen"
  }
}
