{
  "name": "@poffy-ui/react",
  "description": "Poffy UI React - animation-rich UI components powered by Panda CSS and Motion",
  "keywords": [
    "react",
    "ui",
    "component-library",
    "panda-css",
    "design-system",
    "typescript"
  ],
  "homepage": "https://github.com/paletics/poffy-ui#readme",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "type": "commonjs",
  "license": "Apache-2.0",
  "author": "paletics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paletics/poffy-ui.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./style/poffy-ui.min.css": "./dist/style/poffy-ui.min.css",
    "./ssr": {
