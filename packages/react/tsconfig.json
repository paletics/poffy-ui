{
  "extends": "@poffy-ui/typescript-config/react.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@poffy-ui/behavior": ["../behavior/dist/index.d.ts"],
      "@poffy-ui/behavior/calendar": ["../behavior/dist/calendar/index.d.ts"],
      "@poffy-ui/behavior/hooks": ["../behavior/dist/hooks/index.d.ts"],
      "@poffy-ui/behavior/logic": ["../behavior/dist/logic/index.d.ts"],
      "@poffy-ui/behavior/pagination": ["../behavior/dist/pagination/index.d.ts"],
      "@poffy-ui/behavior/*": ["../behavior/dist/*"],
      "@/styled-system/*": ["./src/styled-system/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.stories.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.visual.spec.ts",
    "src/components/e2e"
  ]
}
